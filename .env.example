# Скопировать в .env и заполнить. .env в git не коммитится.

# --- приложение ---
PORT=3000
APP_URL=https://tracker.example.ru
DATABASE_URL=file:./data/app.sqlite
IP_SALT=change-me-to-a-long-random-string
# Ключ шифрования чужих токенов в базе. Без него ключ выводится из IP_SALT,
# и при старте в лог пишется предупреждение. Смена ключа делает старые токены нечитаемыми.
SECRET_KEY=change-me-to-another-long-random-string
SECURE_COOKIES=true
TRUST_PROXY=true

# --- первый администратор (создаётся при старте, если пользователя ещё нет) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Telegram ---
# Токен у @BotFather. Без него адаптер работает в режиме mock и наружу не ходит.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=
# Произвольная строка: её Telegram будет присылать в заголовке X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=

# --- MAX ---
# Профиль организации на dev.max.ru, бот у @MasterBot. Без токена — режим mock.
MAX_BOT_TOKEN=
MAX_BOT_NAME=
MAX_WEBHOOK_SECRET=

# --- фоновые задачи ---
CONVERSION_WORKER_MS=60000
INVITE_POOL_SIZE=20

# Токены Яндекса задаются не здесь, а в интерфейсе для каждого проекта:
# раздел «Интеграции». Один сервис обслуживает много клиентов с разными счётчиками.
